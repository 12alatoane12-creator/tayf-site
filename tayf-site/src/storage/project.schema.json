{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tayf.local/schemas/project.schema.json",
  "title": "Tayf project export v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schemaVersion", "exportedAt", "experiments"],
  "properties": {
    "kind": { "const": "tayf-project" },
    "schemaVersion": { "const": 1 },
    "exportedAt": { "type": "string", "format": "date-time" },
    "experiments": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/experiment" }
    }
  },
  "$defs": {
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "notes", "type", "created", "updated", "data"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,80}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 90 },
        "notes": { "type": "string", "maxLength": 10000 },
        "type": { "enum": ["physics", "chemistry"] },
        "created": { "type": "string", "format": "date-time" },
        "updated": { "type": "string", "format": "date-time" },
        "data": {
          "oneOf": [
            { "$ref": "#/$defs/physicsData" },
            { "$ref": "#/$defs/chemistryData" }
          ]
        }
      }
    },
    "physicsData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stateId", "components", "wires", "referenceTerminal"],
      "properties": {
        "stateId": { "type": "string", "minLength": 1 },
        "components": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/component" } },
        "wires": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/wire" } },
        "referenceTerminal": { "type": "string" },
        "lastCircuit": { "type": ["object", "null"] }
      }
    },
    "chemistryData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stateId", "chemicals", "volume", "sampleVolume", "temperature", "mode"],
      "properties": {
        "stateId": { "type": "string", "minLength": 1 },
        "chemicals": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/chemical" } },
        "volume": { "type": ["string", "number"] },
        "sampleVolume": { "type": ["string", "number"] },
        "temperature": { "type": ["string", "number"] },
        "mode": { "enum": ["auto", "acidbase", "precipitation", "dilution"] },
        "lastChem": { "type": ["object", "null"] }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "name", "value", "x", "y"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,80}$" },
        "type": { "enum": ["source", "resistor", "switch", "capacitor", "inductor", "ammeter", "voltmeter", "diode"] },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "value": { "type": "number" },
        "x": { "type": "number", "minimum": 0, "maximum": 760 },
        "y": { "type": "number", "minimum": 0, "maximum": 390 },
        "unit": { "type": "string" },
        "desc": { "type": "string" },
        "symbol": { "type": "string" },
        "n1": { "type": "number" },
        "n2": { "type": "number" }
      }
    },
    "wire": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,80}$" },
        "from": { "$ref": "#/$defs/terminal" },
        "to": { "$ref": "#/$defs/terminal" }
      }
    },
    "terminal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["componentId", "terminal"],
      "properties": {
        "componentId": { "type": "string" },
        "terminal": { "enum": ["a", "b"] }
      }
    },
    "chemical": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "formula", "cat", "color", "conc", "molar", "phase", "kind", "safety", "source", "version", "molarMassVerified", "moles", "volume"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_-]{1,50}$" },
        "name": { "type": "string", "minLength": 1 },
        "formula": { "type": "string", "minLength": 1 },
        "cat": { "enum": ["acid", "base", "salt", "indicator"] },
        "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "conc": { "type": "number", "minimum": 0 },
        "molar": { "type": "number", "exclusiveMinimum": 0 },
        "phase": { "type": "string" },
        "kind": { "type": "string" },
        "safety": { "type": "string" },
        "source": { "type": "string" },
        "version": { "type": "string" },
        "molarMassVerified": { "type": "boolean" },
        "moles": { "type": "number", "minimum": 0 },
        "volume": { "type": "number", "minimum": 0 }
      }
    }
  }
}
