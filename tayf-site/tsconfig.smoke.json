{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": ".test-dist",
    "noEmit": false,
    "resolveJsonModule": true
  },
  "include": [
    "src/engine/**/*.ts",
    "src/security/**/*.ts",
    "src/storage/**/*.ts",
    "src/state/**/*.ts",
    "src/ui/geometry.ts"
  ]
}
