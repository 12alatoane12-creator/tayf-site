{
  "name": "tayf-virtual-lab",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "منصة طيف للمختبر الافتراضي في الفيزياء والكيمياء",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "format": "prettier --write .",
    "test:smoke": "tsc -p tsconfig.smoke.json && node --test tests/core-smoke.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.15.0",
    "eslint": "^9.30.0",
    "prettier": "^3.6.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
